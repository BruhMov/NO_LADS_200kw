<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Same shape as the MRB-100 Centurion's csproj: netstandard2.1 BepInEx plugin. The plugin compiles WITHOUT a
         reference to Assembly-CSharp.dll (all game types are resolved by name at runtime, GameReflect.cs), so the game
         assembly no longer needs to be present at build time and game patches that only move namespaces cannot break
         the build. -->
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>Lads200</AssemblyName>
    <RootNamespace>Lads200</RootNamespace>
    <Version>2.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>annotations</Nullable> <!-- silences CS8632: the ?-annotations are intentional -->
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>

    <!-- Point at your install: dotnet build -p:GameDir="C:\...\Nuclear Option"  or set NUCLEAR_OPTION_DIR.
         Any folder with BepInEx\core\{BepInEx,0Harmony}.dll and NuclearOption_Data\Managed\UnityEngine*.dll works,
         including the game-ref/ folder described in the README. -->
    <GameDir Condition="'$(GameDir)' == '' and '$(NUCLEAR_OPTION_DIR)' != ''">$(NUCLEAR_OPTION_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">..\..\game-ref</GameDir>
    <Managed>$(GameDir)\NuclearOption_Data\Managed</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx" HintPath="$(GameDir)\BepInEx\core\BepInEx.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(Managed)\UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(Managed)\UnityEngine.CoreModule.dll" Private="false" />
  </ItemGroup>

  <Target Name="ValidateGameDir" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDir)\BepInEx\core\BepInEx.dll')" Text="BepInEx 5 not found at GameDir '$(GameDir)'. Pass -p:GameDir=... or set NUCLEAR_OPTION_DIR (see README: Build)." />
    <Error Condition="!Exists('$(Managed)\UnityEngine.CoreModule.dll')" Text="UnityEngine.CoreModule.dll not found under '$(Managed)'." />
  </Target>
</Project>
